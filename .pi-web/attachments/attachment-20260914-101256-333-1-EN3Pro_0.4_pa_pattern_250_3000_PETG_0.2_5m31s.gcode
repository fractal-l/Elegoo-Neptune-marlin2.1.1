; bigtree thumbnail end

; external perimeters extrusion width = 0.42mm
; perimeters extrusion width = 0.45mm
; infill extrusion width = 0.45mm
; solid infill extrusion width = 0.42mm
; top infill extrusion width = 0.42mm
; support material extrusion width = 0.42mm
; first layer extrusion width = 0.56mm

; EXECUTABLE_BLOCK_START
EXCLUDE_OBJECT_DEFINE NAME=Orca-PA-Calibration-Test CENTER=0,0 POLYGON=[[25,25],[205,25],[205,205],[25,205],[25,25]]
M73 P0 R5
M201 X3000 Y3000 Z150 E500
M203 X250 Y250 Z15 E25
M204 P3000 R3000 T3000 ; sets acceleration (P, T) and retract acceleration (R), mm/sec^2
M205 X8.00 Y8.00 Z0.40 E5.00 ; sets the jerk limits, mm/sec
M205 J0.010
;TYPE:Custom
M400 ;Wait for moves to finish
;Elegoo Neptune 3 Pro
;initial_filament:PETG
;curr_bed_type=High Temp Plate

M220 S100 ;Set the feed speed to 100%
M221 S100 ;Set the flow rate to 100%

M140 S80 ;Heat bed
M109 S240 ;Heat nozzle and wait

G90 ;Absolute positioning
M82 ;Extruder absolute mode

G28 ;Home all axes
M420 S1 ;Load saved mesh

G1 Z10 F1200 ;Move print head up
G1 X65 Y0.5 F18000 ;Move to purge position

G92 E0 ;Reset extruder

G1 Z0.35 F300 ;Move nozzle close to bed
G1 X165 E18 F300 ;Draw the first line
G1 Z0.6 F300 ;Move nozzle up
M73 P6 R5
G1 X162 F18000 ;Move to side

G92 E0 ;Reset extruder

;LAYER_COUNT:2
;LAYER:0
G90
G21
M83 ; use relative distances for extrusion
; filament start gcode
M900 K0; Override pressure advance value
M106 S0
;LAYER_CHANGE
;Z:0.2
;HEIGHT:0.2
;BEFORE_LAYER_CHANGE
;0.2
G92 E0

;LAYER:1

;_SET_FAN_SPEED_CHANGING_LAYER
M204 P3000
;CUSTOM_GCODE
; start pressure advance pattern for layer
G1 E-.4 F1800
G1 X72.315 Y87.287 F15000
G1 E.4 F1800
G1 Z.2 F15000
M73 P7 R5
M900 K0; Override pressure advance value
